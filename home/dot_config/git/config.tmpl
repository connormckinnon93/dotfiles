# Managed by chezmoi. Identity comes from `chezmoi init` prompts (kept out of
# the public source).
{{- /* Signing is headed-only. The key lives in 1Password (personal vault on
       personal machines, work vault on work), and reading it needs the CLI with
       an app session, which headless boxes lack. The work boundary bans the
       *personal* vault on work, not 1Password itself — .signingKeyRef is
       prompted per-machine so each profile references its own vault. */ -}}
{{- $signing := not .headless }}

[user]
    name = {{ .name }}
    email = {{ .email }}
{{- if $signing }}
    signingkey = {{ onepasswordRead .signingKeyRef | quote }}
{{- end }}
{{ if $signing }}
# Commit/tag signing via 1Password's SSH agent (op-ssh-sign).
[gpg]
    format = ssh
[gpg "ssh"]
    program = {{ .opSshSign | quote }}
    allowedSignersFile = ~/.config/git/allowed_signers
[commit]
    gpgsign = true
    verbose = true
[tag]
    gpgsign = true
    sort = version:refname
{{ else }}
[commit]
    verbose = true
[tag]
    sort = version:refname
{{ end }}

# Sensible defaults.
[init]
    defaultBranch = main
[push]
    autoSetupRemote = true
[pull]
    ff = only
[fetch]
    prune = true
[rebase]
    autoStash = true
    autoSquash = true
[merge]
    conflictStyle = zdiff3
[diff]
    algorithm = histogram
    colorMoved = default
[branch]
    sort = -committerdate
[column]
    ui = auto

# git-lfs, declared rather than run imperatively: this block is exactly what
# `git lfs install` writes to the global config, so the git-lfs brew works in
# any repo without a one-time setup step.
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

{{ if $signing -}}
# Always use SSH for GitHub (rewrite https remotes to ssh) — headed only, since
# SSH auth relies on the 1Password agent that lives inside the same $signing
# gate above. On headless boxes the agent is absent, so leave HTTPS clones as-is
# (they otherwise fail with `Permission denied (publickey)`, breaking anything
# that clones GitHub repos: antidote, nvim lazy, mise plugins, brew taps, …).
[url "git@github.com:"]
    insteadOf = https://github.com/
{{ end -}}

# delta as the diff/pager, themed Catppuccin Mocha. The feature block below is
# vendored from catppuccin/delta; its syntax-theme reuses bat's built tmTheme.
[core]
    pager = delta
    excludesFile = ~/.config/git/ignore
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    line-numbers = true
    features = catppuccin-mocha
[delta "catppuccin-mocha"]
    blame-palette = "#1e1e2e #181825 #11111b #313244 #45475a"
    commit-decoration-style = "#6c7086" bold box ul
    dark = true
    file-decoration-style = "#6c7086"
    file-style = "#cdd6f4"
    hunk-header-decoration-style = "#6c7086" box ul
    hunk-header-file-style = bold
    hunk-header-line-number-style = bold "#a6adc8"
    hunk-header-style = file line-number syntax
    line-numbers-left-style = "#6c7086"
    line-numbers-minus-style = bold "#f38ba8"
    line-numbers-plus-style = bold "#a6e3a1"
    line-numbers-right-style = "#6c7086"
    line-numbers-zero-style = "#6c7086"
    minus-emph-style = bold syntax "#694559"
    minus-style = syntax "#493447"
    plus-emph-style = bold syntax "#4e6356"
    plus-style = syntax "#394545"
    map-styles = \
        bold purple => syntax "#5b4e74", \
        bold blue => syntax "#445375", \
        bold cyan => syntax "#446170", \
        bold yellow => syntax "#6b635b"
    syntax-theme = Catppuccin Mocha
{{- /* vim: set filetype=gitconfig: */}}
