# Managed by chezmoi.
HashKnownHosts no
{{ if not .headless }}
Host *
  # Authenticate via 1Password's SSH agent (key lives in 1Password, not on disk).
  # Headed-only: headless boxes have no 1Password app to run the agent. The
  # socket path is a per-app Group Container ID, so the same value works whether
  # 1Password is signed into the personal or the work vault. The work boundary
  # bans the *personal* vault on work, not 1Password itself (see CLAUDE.md).
  IdentityAgent "{{ .onePasswordAgent }}"
{{ end }}
Host github.com
  User git
{{ if eq .profile "personal" }}
# Personal homelab — profile-gated so a work machine renders none of these
# (work boundary: no personal hosts/accounts, see CLAUDE.md).
Host git.catinthehack.ca
  HostName 192.168.20.40
  Port 2222
  User git

Host forge
  HostName 192.168.20.40
  User cm

Host pve
  HostName 192.168.20.5
  User cm

Host edge
  HostName 192.168.20.20
  User cm

Host paas
  HostName 192.168.20.30
  User cm

Host identity
  HostName 192.168.20.50
  User cm

Host nas
  HostName 192.168.20.15
  User cm
{{ end }}
{{- /* vim: set filetype=sshconfig: */}}
